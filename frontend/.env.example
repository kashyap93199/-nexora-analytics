# Copy to frontend/.env.local when the API is NOT served from the same origin.
# In development, `npm run dev` proxies /api to http://127.0.0.1:8000, so no
# variable is required. In production the nginx container proxies /api too.
# Only set this if you host the SPA and API on different domains:
# VITE_API_URL=https://api.nexora.example
