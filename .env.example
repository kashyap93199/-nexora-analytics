# ── Nexora Analytics environment ──────────────────────────────────────────
# Copy to `.env` before running `docker compose up`. Never commit `.env`.

# Security — generate a strong random value, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-string

# Application
APP_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (used by docker-compose; the backend also accepts any DATABASE_URL)
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_DB=nexora
DATABASE_URL=postgresql+psycopg://nexora:nexora_dev_password@db:5432/nexora

# Rate limiting
RATE_LIMIT_ENABLED=true

# Reverse proxy — honour X-Forwarded-For for rate limiting ONLY when the API sits behind
# a trusted proxy (nginx in docker-compose). Never enable when the API is directly reachable.
TRUST_PROXY_HEADERS=true
